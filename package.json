{
  "name": "game-hub",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sdk.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "start": "node dist/src/server.js",
    "admin": "tsx scripts/admin.ts",
    "migrate": "tsx scripts/admin.ts migrate",
    "check": "npm run build && npm run typecheck && npm test",
    "mcp:start": "node dist/src/mcp/server.js",
    "mcp:dev": "tsx watch src/mcp/server.ts",
    "mcp:admin": "tsx scripts/mcp-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@sinclair/typebox": "^0.34.52",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "mime-types": "^3.0.2",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.4",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "esbuild": "^0.28.2",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
