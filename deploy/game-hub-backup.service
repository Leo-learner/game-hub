[Unit]
Description=Game Hub verified backup
After=game-hub.service
[Service]
Type=oneshot
User=gamehub
Group=www-data
WorkingDirectory=/opt/apps/game-hub/current
EnvironmentFile=/etc/game-hub.env
ExecStart=/usr/bin/node --max-old-space-size=128 dist/scripts/admin.js backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/game-hub
MemoryMax=256M
