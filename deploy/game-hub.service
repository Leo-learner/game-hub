[Unit]
Description=Game Hub API
After=network.target
[Service]
Type=simple
User=gamehub
Group=www-data
WorkingDirectory=/opt/apps/game-hub/current
EnvironmentFile=/etc/game-hub.env
ExecStart=/usr/bin/node --max-old-space-size=128 dist/src/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/game-hub
RestrictSUIDSGID=true
MemoryHigh=192M
MemoryMax=256M
[Install]
WantedBy=multi-user.target
